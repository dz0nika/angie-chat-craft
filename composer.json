{
    "name": "dz0nika/angie-chat-craft",
    "version": "1.1.3",
    "description": "AI chat for Craft CMS and Craft Commerce that answers shoppers from your own content, products, prices and stock, in their language.",
    "type": "craft-plugin",
    "license": "MIT",
    "keywords": [
        "craft",
        "craftcms",
        "craft-plugin",
        "craft-commerce",
        "ai",
        "chatbot",
        "ai-assistant",
        "chat",
        "widget",
        "ecommerce",
        "customer-support",
        "multilingual"
    ],
    "authors": [
        {
            "name": "Nikola Popovic",
            "email": "nikola@angiechat.com"
        }
    ],
    "support": {
        "email": "info@angiechat.com",
        "docs": "https://angiechat.com/documentation"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "suggest": {
        "craftcms/commerce": "Required for abandoned cart recovery feature"
    },
    "autoload": {
        "psr-4": {
            "Dz0nika\\AngieChatCraft\\": "src/"
        }
    },
    "extra": {
        "handle": "angie-chat",
        "name": "Angie Chat",
        "developer": "Nikola Popovic",
        "developerUrl": "https://angiechat.com",
        "documentationUrl": "https://angiechat.com/documentation",
        "class": "Dz0nika\\AngieChatCraft\\AngieChat",
        "description": "AI chat that answers shoppers from your content, products, prices and stock, in their language."
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "homepage": "https://angiechat.com/craft-cms-ai-chatbot"
}
