{% import '_includes/forms.twig' as forms %}

<style>
    .angie-chat-settings {
        max-width: 800px;
    }
    .angie-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 9999px;
        font-size: 13px;
        font-weight: 500;
    }
    .angie-status-connected {
        background: #dcfce7;
        color: #166534;
    }
    .angie-status-disconnected {
        background: #fee2e2;
        color: #991b1b;
    }
    .angie-usage-grid {
        display: grid;
        gap: 12px;
        margin-top: 16px;
    }
    .angie-usage-row {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 12px 14px;
    }
    .angie-usage-row-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 13px;
        margin-bottom: 6px;
    }
    .angie-usage-row-label {
        font-weight: 600;
        color: #1e293b;
    }
    .angie-usage-row-meta {
        color: #64748b;
        font-variant-numeric: tabular-nums;
    }
    .angie-usage-bar {
        height: 6px;
        background: #e2e8f0;
        border-radius: 9999px;
        overflow: hidden;
    }
    .angie-usage-bar-fill {
        height: 100%;
        background: #16a34a;
        transition: width 0.2s ease;
    }
    .angie-usage-bar-fill.warning { background: #f59e0b; }
    .angie-usage-bar-fill.blocked { background: #dc2626; }
    .angie-usage-banner {
        margin-top: 12px;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 13px;
        line-height: 1.4;
    }
    .angie-usage-banner.warning {
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: #92400e;
    }
    .angie-usage-banner.blocked {
        background: #fee2e2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }
    .angie-section-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 8px;
    }
    .angie-section-card:hover {
        border-color: #cbd5e1;
    }
    .angie-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .angie-section-name {
        font-weight: 600;
        color: #1e293b;
    }
    .angie-section-meta {
        font-size: 13px;
        color: #64748b;
        margin-top: 4px;
    }
    .angie-entry-count {
        background: #e2e8f0;
        color: #475569;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 12px;
    }
    .angie-sync-button {
        margin-top: 24px;
    }
    .angie-help-text {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 24px;
    }
    .angie-help-text h4 {
        margin: 0 0 8px 0;
        color: #1e40af;
        font-size: 14px;
    }
    .angie-help-text p {
        margin: 0;
        color: #1e3a8a;
        font-size: 13px;
    }
</style>

<div class="angie-chat-settings">
    {# Connection Status #}
    <div style="margin-bottom: 24px;">
        <h2>Connection Status</h2>
        {% if syncStatus.connected %}
            <span class="angie-status-badge angie-status-connected">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M13.5 4.5L6 12L2.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Connected to Angie Chat
            </span>
            {% if syncStatus.data.vector_stats is defined %}
                <p style="margin-top: 8px; color: #64748b; font-size: 13px;">
                    {{ syncStatus.data.vector_stats.chunk_count ?? 0 }} content chunks synced
                    {% if syncStatus.data.vector_stats.last_synced_at %}
                        · Last sync: {{ syncStatus.data.vector_stats.last_synced_at|date('M j, Y g:ia') }}
                    {% endif %}
                </p>
            {% endif %}
        {% else %}
            <span class="angie-status-badge angie-status-disconnected">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M12 4L4 12M4 4L12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                Not Connected
            </span>
            <p style="margin-top: 8px; color: #991b1b; font-size: 13px;">
                {{ syncStatus.message ?? 'Please enter your license key below.' }}
            </p>
        {% endif %}
    </div>

    <hr>

    {# Monthly Usage — block-or-warn banner + per-budget bars #}
    {% set usage = syncStatus.usage ?? syncStatus.data.usage ?? null %}
    {% if usage and usage.status is defined %}
        <div style="margin-bottom: 24px;">
            <h2>Monthly Usage</h2>
            <p style="color: #64748b; margin: 0 0 4px; font-size: 13px;">
                Resets {{ usage.reset_at|date('M j, Y') }}.
                Override per-website limits from your
                <a href="https://app.angiechat.com/dashboard" target="_blank">Angie Chat dashboard</a>.
            </p>

            {% if usage.status == 'blocked' %}
                <div class="angie-usage-banner blocked">
                    <strong>Chat is paused.</strong>
                    {% if usage.blocking_reason == 'monthly_chat_sessions' %}
                        You've reached this month's chat session limit.
                    {% elseif usage.blocking_reason == 'monthly_tokens' %}
                        You've reached this month's AI usage budget.
                    {% elseif usage.blocking_reason == 'api_suspended' %}
                        API access has been suspended. Contact support.
                    {% else %}
                        Monthly usage limit reached.
                    {% endif %}
                    The widget is temporarily hidden and content sync is paused. Upgrade your plan or wait for the next reset.
                </div>
            {% elseif usage.status == 'warning' %}
                <div class="angie-usage-banner warning">
                    <strong>Heads up:</strong> you're approaching this month's quota.
                    Consider upgrading your plan to avoid an interruption.
                </div>
            {% endif %}

            <div class="angie-usage-grid">
                {% for key, label in {
                    'monthly_chat_sessions': 'Chat sessions',
                    'monthly_tokens':        'AI tokens',
                    'headless_messages':     'Headless API messages'
                } %}
                    {% set budget = usage.budgets[key] ?? null %}
                    {% if budget and budget.limit > 0 %}
                        {% set percent = (budget.percent * 100)|round %}
                        {% set fillClass = 'ok' %}
                        {% if usage.status == 'blocked' and usage.blocking_reason == key %}
                            {% set fillClass = 'blocked' %}
                        {% elseif percent >= 90 %}
                            {% set fillClass = 'warning' %}
                        {% endif %}
                        <div class="angie-usage-row">
                            <div class="angie-usage-row-head">
                                <span class="angie-usage-row-label">{{ label }}</span>
                                <span class="angie-usage-row-meta">
                                    {{ budget.used|number_format }} / {{ budget.limit|number_format }} ({{ percent }}%)
                                </span>
                            </div>
                            <div class="angie-usage-bar">
                                <div class="angie-usage-bar-fill {{ fillClass }}" style="width: {{ percent|number_format(2, '.', '') }}%;"></div>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <hr>
    {% endif %}

    {# API Credentials — license + widget key + webhook secret #}
    <div style="margin-top: 24px;">
        <h2>API Credentials</h2>
        <div class="angie-help-text">
            <h4>Where do I find these?</h4>
            <p>
                Log in to your <a href="https://app.angiechat.com/dashboard" target="_blank">Angie Chat Dashboard</a>,
                open your website's <strong>Connection</strong> tab, and copy all three values below.
                The license key and webhook secret are <strong>server-only secrets</strong> and never sent to the browser.
                The widget public key is safe to expose — it's domain-locked.
            </p>
        </div>

        {{ forms.passwordField({
            label: 'License Key',
            instructions: 'Server-only secret. Authenticates outbound webhooks from this Craft site.',
            id: 'licenseKey',
            name: 'licenseKey',
            value: settings.licenseKey,
            placeholder: 'sk_angie_live_xxxxxxxxxxxxxxxx',
            required: true,
            errors: settings.getErrors('licenseKey')
        }) }}

        {{ forms.textField({
            label: 'Widget Public Key',
            instructions: 'Safe to expose in HTML. Used by the chat widget; domain-locked server-side.',
            id: 'widgetPublicKey',
            name: 'widgetPublicKey',
            value: settings.widgetPublicKey,
            placeholder: 'pk_widget_xxxxxxxxxxxxxxxx',
            errors: settings.getErrors('widgetPublicKey')
        }) }}

        {{ forms.passwordField({
            label: 'Webhook Secret',
            instructions: 'Server-only HMAC key. Every outbound webhook is signed with this secret so the backend can verify it really came from your Craft install.',
            id: 'webhookSecret',
            name: 'webhookSecret',
            value: settings.webhookSecret,
            placeholder: 'whk_xxxxxxxxxxxxxxxx',
            errors: settings.getErrors('webhookSecret')
        }) }}

        {% if not settings.webhookSecret and settings.licenseKey %}
            <div style="margin-top: 12px; padding: 10px 14px; background: #fefce8; border: 1px solid #fde68a; border-radius: 6px; color: #854d0e; font-size: 13px;">
                <strong>Grace period:</strong> No webhook secret configured yet. Outbound webhooks will continue
                working unsigned for now, but Angie Chat will start requiring HMAC signatures soon. Add the
                webhook secret from your dashboard to upgrade now.
            </div>
        {% endif %}
    </div>

    <hr>

    {# Content Sections #}
    <div style="margin-top: 24px;">
        <h2>Content Sections</h2>
        <p style="color: #64748b; margin-bottom: 16px;">
            Select which Craft sections should be synced to the AI. Only content from enabled sections
            will be used to answer customer questions.
        </p>

        {% if sections|length > 0 %}
            <div class="angie-sections-list">
                {% for section in sections %}
                    <div class="angie-section-card">
                        <div class="angie-section-header">
                            <div>
                                {{ forms.checkbox({
                                    label: section.name,
                                    name: 'enabledSections[]',
                                    value: section.handle,
                                    checked: section.handle in settings.enabledSections
                                }) }}
                                <div class="angie-section-meta">
                                    Handle: <code>{{ section.handle }}</code> · Type: {{ section.type|capitalize }}
                                </div>
                            </div>
                            <span class="angie-entry-count">{{ section.entryCount }} entries</span>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p style="color: #64748b; font-style: italic;">
                No sections found. Create some sections in Craft to get started.
            </p>
        {% endif %}
    </div>

    <hr>

    {# Widget Settings #}
    <div style="margin-top: 24px;">
        <h2>Widget Settings</h2>

        {{ forms.lightswitchField({
            label: 'Auto-inject Widget',
            instructions: 'Automatically add the chat widget to all frontend pages.',
            id: 'autoInjectWidget',
            name: 'autoInjectWidget',
            on: settings.autoInjectWidget
        }) }}

        {{ forms.textField({
            label: 'Exclude Pages',
            instructions: 'Comma-separated patterns. Use **URL paths** (start with `/`) like `/checkout` or `/account` to hide on those routes and any sub-routes. Use **CSS selectors** like `.no-chat`, `#cart-page`, or `[data-no-chat]` to hide on any page where a matching element is present. URL paths re-evaluate on SPA navigation (pushState/replaceState).',
            id: 'excludeSelectors',
            name: 'excludeSelectors',
            value: settings.excludeSelectors,
            placeholder: '/checkout, /account, .no-chat',
            errors: settings.getErrors('excludeSelectors')
        }) }}
    </div>

    <hr>

    {# Craft Commerce — Abandoned Cart Recovery #}
    <div style="margin-top: 24px;">
        <h2>Craft Commerce — Abandoned Cart Recovery</h2>

        {% set hasAbandonedCartFeature = 'abandoned-cart' in enabledFeatures %}
        {% set hasCommerce = craft.app.plugins.isPluginInstalled('commerce') and craft.app.plugins.isPluginEnabled('commerce') %}

        {% if not hasAbandonedCartFeature %}
            {# Feature not on this subscription — upsell #}
            <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 16px; color: #78350f;">
                <p style="margin: 0 0 8px 0;">
                    <strong>Abandoned Cart Recovery is not active on your current plan.</strong>
                </p>
                <p style="margin: 0; font-size: 13px;">
                    Upgrade to the <strong>Growth Tier</strong> from your
                    <a href="https://app.angiechat.com/dashboard/billing" target="_blank" style="color:#d97706;">Angie Chat dashboard</a>
                    to enable AI-powered recovery emails.
                </p>
            </div>
        {% elseif not hasCommerce %}
            {# Feature enabled but Commerce not present #}
            <div style="background: #f1f5f9; border-radius: 8px; padding: 16px; color: #475569;">
                <p style="margin: 0;">
                    <strong>Craft Commerce not detected.</strong><br>
                    Install and enable Craft Commerce to use abandoned cart recovery.
                </p>
            </div>
        {% else %}
            {# Feature enabled + Commerce present — show the toggle #}
            {{ forms.lightswitchField({
                label: 'Enable Abandoned Cart Recovery',
                instructions: 'Detects abandoned carts via a scheduled cron command and sends recovery data to Angie Chat.',
                id: 'enableAbandonedCart',
                name: 'enableAbandonedCart',
                on: settings.enableAbandonedCart
            }) }}

            {% if settings.enableAbandonedCart %}
                <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 12px 16px; margin-top: 12px; font-size: 13px; color: #1e40af;">
                    <strong>Cron required.</strong> Add this to your server's crontab (every 30 minutes):<br>
                    <code style="display:block; margin-top:8px; background:#dbeafe; padding:6px 10px; border-radius:4px; font-size:12px;">
                        0,30 * * * * /path/to/php /path/to/craft angie-chat/carts/check-abandoned
                    </code>
                </div>
            {% endif %}
        {% endif %}
    </div>

    <hr>

    {# Force Sync Button #}
    <div class="angie-sync-button" style="margin-top: 24px;">
        <h2>Sync All Content</h2>
        <p style="color: #64748b; margin-bottom: 16px;">
            Use this button to immediately sync all content from enabled sections to the AI.
            This is useful after first installing the plugin or after making bulk content changes.
        </p>

        <a href="{{ cpUrl('angie-chat/sync-all') }}" class="btn submit" id="syncAllBtn">
            Force Sync All Data
        </a>

        <p style="margin-top: 8px; font-size: 13px; color: #64748b;">
            This will queue all entries for background processing. Large sites may take several minutes.
        </p>
    </div>
</div>

<script>
document.getElementById('syncAllBtn')?.addEventListener('click', function(e) {
    if (!confirm('This will queue all entries from enabled sections for sync. Continue?')) {
        e.preventDefault();
    }
});
</script>
